---
import Base from '../layouts/Base.astro';
import { site, about, education, experience, skills, fieldwork, presentations, awards } from '../siteData';
import { getCollection } from 'astro:content';
import Helix from '../components/Helix.astro';
import Slideshow from '../components/Slideshow.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });

const social = [
  { key: 'googleScholar', label: 'Google Scholar' },
  { key: 'orcid', label: 'ORCID' },
  { key: 'researchGate', label: 'ResearchGate' },
  { key: 'github', label: 'GitHub' },
  { key: 'linkedin', label: 'LinkedIn' },
  { key: 'twitter', label: 'Twitter' },
] as const;
---

<Base>
  <section class="hero">
    <Helix />
    <div class="wrap hero-grid">
      <img class="hero-photo" src="/profile.jpg" alt={site.name} width="150" height="150" />
      <div class="hero-text">
      <h1>{site.name}</h1>
      <p class="role">{site.role}</p>
      <p class="tagline">{site.tagline}</p>

      <ul class="contact">
        {site.affiliation && (
          <li>
            <svg class="ci" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 21V7l9-4 9 4v14M3 21h18M9 21v-6h6v6M7 10h.01M12 10h.01M17 10h.01"/></svg>
            <span>{site.affiliation}</span>
          </li>
        )}
        {site.location && (
          <li>
            <svg class="ci" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-6.5-7-11a7 7 0 0114 0c0 4.5-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
            <span>{site.location}</span>
          </li>
        )}
        {site.email && (
          <li>
            <svg class="ci" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </li>
        )}
        {site.phone && (
          <li>
            <svg class="ci" viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.9v3a2 2 0 01-2.2 2 19.8 19.8 0 01-8.6-3.1 19.5 19.5 0 01-6-6A19.8 19.8 0 012.1 4.2 2 2 0 014.1 2h3a2 2 0 012 1.7c.1.9.3 1.8.6 2.6a2 2 0 01-.5 2.1L8.1 9.6a16 16 0 006 6l1.2-1.1a2 2 0 012.1-.5c.8.3 1.7.5 2.6.6a2 2 0 011.7 2z"/></svg>
            <a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a>
            {site.phoneAlt && <span class="alt"> · <a href={`tel:${site.phoneAlt.replace(/\s/g, '')}`}>{site.phoneAlt}</a> (UZ / WhatsApp)</span>}
          </li>
        )}
      </ul>

      <div class="social">
        {
          social
            .filter((s) => site.links[s.key])
            .map((s) => (
              <a href={site.links[s.key]} target="_blank" rel="noopener">
                {s.label}
              </a>
            ))
        }
        <a href={`mailto:${site.email}`}>Email</a>
      </div>
      {site.cvFile && (
        <a class="cv-button" href={site.cvFile} target="_blank" rel="noopener">
          <svg class="ci" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m0 0l-4-4m4 4l4-4M4 17v2a2 2 0 002 2h12a2 2 0 002-2v-2"/></svg>
          Download CV (PDF)
        </a>
      )}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2 data-idx="01">About</h2>
      <p set:html={about.trim().replace(/\n/g, ' ')} />
    </div>
  </section>

  <section>
    <div class="wrap">
      <Slideshow />
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2 data-idx="02">Education</h2>
      {
        education.map((e) => (
          <div class="entry">
            <h3>{e.degree}</h3>
            <span class="period">{e.period}</span>
            <span class="org">{e.institution}</span>
            {e.note && <span class="note">{e.note}</span>}
          </div>
        ))
      }
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2 data-idx="03">Experience</h2>
      {
        experience.map((e) => (
          <div class="entry">
            <h3>{e.title}</h3>
            <span class="period">{e.period}</span>
            <span class="org">{e.org}</span>
            {e.note && <span class="note">{e.note}</span>}
          </div>
        ))
      }
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2 data-idx="04">Fieldwork &amp; research experience</h2>
      {
        fieldwork.map((f) => (
          <div class="entry">
            <h3>{f.title}</h3>
            <span class="period">{f.period}</span>
            {f.note && <span class="note">{f.note}</span>}
          </div>
        ))
      }
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2 data-idx="05">Technical skills</h2>
      <div class="skills-grid">
        {
          skills.map((s) => (
            <div class="skill-group">
              <h3>{s.group}</h3>
              <ul>
                {s.items.map((it) => <li>{it}</li>)}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2 data-idx="06">Conference presentations</h2>
      {
        presentations.map((p) => (
          <div class="entry">
            <h3>{p.title}</h3>
            <span class="period">{p.period}</span>
            <span class="org">{p.venue}</span>
            {p.kind && <span class="note">{p.kind}</span>}
          </div>
        ))
      }
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2 data-idx="07">Awards &amp; scholarships</h2>
      {
        awards.map((a) => (
          <div class="entry">
            <h3>{a.title}</h3>
            <span class="period">{a.period}</span>
            <span class="org">{a.org}</span>
          </div>
        ))
      }
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2 data-idx="08">From the blog</h2>
      {
        posts.map((post) => (
          <article class="post">
            <div>
              {post.data.tags.slice(0, 2).map((t) => (
                <span class="tag">{t}</span>
              ))}
            </div>
            <h3>
              <a href={`/blog/${post.slug}`}>{post.data.title}</a>
            </h3>
            <p class="post-meta">{fmt(post.data.date)}</p>
            <p class="excerpt">{post.data.description}</p>
          </article>
        ))
      }
      <a class="view-all" href="/blog">All posts →</a>
    </div>
  </section>
</Base>
