---
import '../styles/global.css';
import { site } from '../siteData';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} — ${site.role}`;
const pageDesc = description ?? site.tagline;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site ?? 'https://akbarjon-rozimov.com').href;

// Structured data: tells Google this site is about a specific researcher.
const sameAs = [
  site.links.googleScholar,
  site.links.orcid,
  site.links.researchGate,
  site.links.github,
  site.links.linkedin,
  site.links.twitter,
].filter(Boolean);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  email: `mailto:${site.email}`,
  url: 'https://akbarjon-rozimov.com',
  affiliation: {
    '@type': 'Organization',
    name: 'Institute of Zoology, Chinese Academy of Sciences',
  },
  sameAs,
};

const nav = [
  { href: '/', label: 'About' },
  { href: '/publications', label: 'Publications' },
  { href: '/blog', label: 'Blog' },
];

function isCurrent(href: string) {
  if (href === '/') return path === '/';
  return path.startsWith(href);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <meta name="author" content={site.name} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Spectral:wght@500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a href="/" class="brand">{site.name}</a>
        <nav class="nav">
          {
            nav.map((item) => (
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <span>© {new Date().getFullYear()} {site.name}</span>
        <span>akbarjon-rozimov.com</span>
      </div>
    </footer>
  </body>
</html>
